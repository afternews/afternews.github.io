---
/**
 * 공유 버튼.
 * 공유 한 번은 새 방문자 여러 명을 데려옵니다. 광고 클릭보다 공유가 중요합니다.
 * 외부 SDK를 쓰지 않아 페이지 속도에 영향이 없습니다.
 */
interface Props {
  title: string;
  url: string;
}
const { title, url } = Astro.props;
const t = encodeURIComponent(title);
const u = encodeURIComponent(url);
---

<div class="share">
  <span class="share__label">이 글이 도움이 되었다면</span>
  <div class="share__row">
    <a
      class="share__btn"
      href={`https://twitter.com/intent/tweet?text=${t}&url=${u}`}
      target="_blank"
      rel="noopener">X</a
    >
    <a
      class="share__btn"
      href={`https://www.threads.net/intent/post?text=${t}%20${u}`}
      target="_blank"
      rel="noopener">스레드</a
    >
    <a
      class="share__btn"
      href={`https://www.facebook.com/sharer/sharer.php?u=${u}`}
      target="_blank"
      rel="noopener">페이스북</a
    >
    <button class="share__btn" type="button" data-copy-url={url}>링크 복사</button>
  </div>
</div>

<script is:inline>
  document.querySelectorAll('[data-copy-url]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var url = btn.getAttribute('data-copy-url');
      var done = function () {
        var old = btn.textContent;
        btn.textContent = '복사됨';
        setTimeout(function () {
          btn.textContent = old;
        }, 1500);
      };
      if (navigator.clipboard) {
        navigator.clipboard.writeText(url).then(done, function () {});
      } else {
        var ta = document.createElement('textarea');
        ta.value = url;
        document.body.appendChild(ta);
        ta.select();
        try {
          document.execCommand('copy');
          done();
        } catch (e) {}
        document.body.removeChild(ta);
      }
    });
  });
</script>
