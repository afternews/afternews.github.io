---
interface Props {
  current: number;
  total: number;
}
const { current, total } = Astro.props;
const href = (n: number) => (n === 1 ? '/posts' : `/posts/page/${n}`);
const pages = Array.from({ length: total }, (_, i) => i + 1).filter(
  (n) => n === 1 || n === total || Math.abs(n - current) <= 1
);
---

{
  total > 1 && (
    <nav class="pagination" aria-label="글 목록 페이지">
      {current > 1 ? (
        <a href={href(current - 1)} rel="prev">
          ← 이전
        </a>
      ) : (
        <span class="is-off">← 이전</span>
      )}

      <ol>
        {pages.map((n, i) => (
          <>
            {i > 0 && pages[i - 1] !== n - 1 && <li class="gap">…</li>}
            <li>
              {n === current ? (
                <span aria-current="page">{n}</span>
              ) : (
                <a href={href(n)}>{n}</a>
              )}
            </li>
          </>
        ))}
      </ol>

      {current < total ? (
        <a href={href(current + 1)} rel="next">
          다음 →
        </a>
      ) : (
        <span class="is-off">다음 →</span>
      )}
    </nav>
  )
}
